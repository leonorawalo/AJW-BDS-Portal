{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "ajwafrica-bags-portal",
          "appId": "1:745290415237:android:a9c6eae1cdec93f8377dec",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "ajwafrica-bags-portal",
          "configurations": {
            "android": "1:745290415237:android:a9c6eae1cdec93f8377dec",
            "web": "1:745290415237:web:04720568111d9e3b377dec"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "predeploy": [
      "node scripts/check_do_not_break.js"
    ],
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|mjs|json|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/.env",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|webp|jpg|jpeg|ico|otf|ttf|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/canvaskit/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
