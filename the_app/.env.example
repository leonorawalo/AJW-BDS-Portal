# Copy to .env and fill in. The app reads ONLY these two values, and they
# ship inside the app: never put a secret key here (the service role key,
# Google client secrets and Firebase keys live only in Supabase Edge
# Function secrets). See docs/security/SECURITY.md.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public anon / publishable key>
